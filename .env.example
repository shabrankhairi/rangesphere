# ---- Image source ----
OWNER=shabrankhairi        # GitHub owner that published the images
TAG=latest

# ---- Portal ----
PORTAL_PORT=8080

# ---- Database ----
PGUSER=rangesphere
PGPASSWORD=change-this-db-password
PGDATABASE=rangesphere

# ---- Auth ----
JWT_SECRET=generate-a-long-random-string
ALLOW_OPEN_REGISTRATION=true

# Default DEMO user (member role) — anyone can log in and try with this.
DEMO_USER=demo
DEMO_PASSWORD=demo123

# Admins are NOT configured in this file. Create/reset the admin from inside
# the running system (password stored hashed in the DB, never in config):
#   docker compose run --rm backend node src/admincli.js set <username> <password>
# People who want admin access ask the maintainer directly.

# Points deducted per WRONG flag submission (0 = disable; capped per challenge).
PENALTY_POINTS=10

# ---- Instance orchestration ----
# 127.0.0.1 = instances reachable only from the host (safest; use VPN/SSH tunnel)
# 0.0.0.0   = reachable from the LAN (ISOLATED training network only)
TARGET_BIND_HOST=127.0.0.1
TARGET_PORT_MIN=20000
TARGET_PORT_MAX=21000
INSTANCE_TTL_MIN=120
MAX_INSTANCES_PER_USER=2
